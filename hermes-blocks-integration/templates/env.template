# --- Blocks (required) ---
# Written by `blocks login --write-env`; never commit this file.
BLOCKS_API_KEY=

# --- This agent's owner identity (never hardcode these in logic) ---
ME_AGENT=<owner>_hermes_<domain>
ME_EMAIL=<owner@example.com>
ME_TZ=<IANA timezone, e.g. Europe/Warsaw>
ME_NAME=<Owner>

# Used by runbook/bridge scripts to target the local agent; defaults to the
# project folder name when unset.
LOCAL_AGENT_NAME=<owner>_hermes_<domain>

# --- Persistence ---
# Absolute path as seen by the RUNNING process (container path if containerized).
PENDING_STORE_PATH=
# Or set a data dir and let the handler derive <DATA_DIR>/pending_approvals.json
DATA_DIR=

# --- Human notification channel (example: Telegram; both required for sends —
#     the handler skips-and-logs when unset, never falls back to a default) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Your domain-specific credentials go below (examples) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TOKEN_PATH=
